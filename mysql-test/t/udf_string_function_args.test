--source include/have_udf.inc

--echo #
--echo # Bug#36314928: Assertion failure !s.uses_buffer_owned_by(this) in
--echo # sql_string.cc. A UDF argument such as CONCAT(), which writes its
--echo # result to the buffer passed to val_str(), got a buffer which overlapped
--echo # its own result of the previous row.
--echo #

--replace_result $UDF_EXAMPLE_LIB UDF_EXAMPLE_LIB
eval CREATE FUNCTION metaphon RETURNS STRING SONAME "$UDF_EXAMPLE_LIB";

CREATE TABLE t1 (id INT, name VARCHAR(16) CHARACTER SET latin1);
INSERT INTO t1 VALUES (1, 'alpha'), (2, 'beta'), (3, 'gamma');

SELECT id, metaphon(CONCAT('word', id)) AS result FROM t1 ORDER BY id;
SELECT id, metaphon(CONCAT(name, id)) AS result FROM t1 ORDER BY id;
SELECT id, metaphon(CONCAT(name, 'x')) AS result FROM t1 ORDER BY id;
SELECT id, metaphon(name) AS result FROM t1 ORDER BY id;

DROP TABLE t1;
DROP FUNCTION metaphon;

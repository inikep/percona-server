echo # Check if any classes are not lost, this may happen if they are already;
echo # just on the limit;
# Only instrument classes: other *_lost counters (e.g. digests, limited to 200
# by default_mysqld.cnf) depend on what earlier tests ran on the same server.
SELECT * FROM performance_schema.global_status WHERE variable_name LIKE '%_CLASSES_LOST' AND variable_value > 0;

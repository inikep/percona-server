--source include/have_rocksdb.inc
SELECT @@global.rocksdb_ttl_session_timestamp_shadow;
CREATE TABLE t(id INT PRIMARY KEY,e BIGINT) ENGINE=ROCKSDB COMMENT='row_ttl_col=e';
INSERT INTO t VALUES(1,150),(2,0);
CREATE TABLE ti(id INT PRIMARY KEY) ENGINE=ROCKSDB COMMENT='ttl_duration=1000';
SET timestamp=100;
# Shadow mode must preserve the wall-clock implicit insert stamp.
INSERT INTO ti VALUES(1);
SELECT * FROM ti;
SET SESSION transaction_isolation='READ-COMMITTED';
BEGIN;
SELECT variable_value INTO @before_count FROM performance_schema.global_status
 WHERE variable_name='rocksdb_ttl_session_read_mismatches';
SELECT id FROM t ORDER BY id;
SELECT variable_value > @before_count AS measured FROM performance_schema.global_status
 WHERE variable_name='rocksdb_ttl_session_read_mismatches';
SET timestamp=200;
SAVEPOINT s;
ROLLBACK TO SAVEPOINT s;
SELECT variable_value INTO @before_count FROM performance_schema.global_status
 WHERE variable_name='rocksdb_ttl_session_read_mismatches';
# The hypothetical clock is still 100 after RC snapshot renewal and savepoint rollback.
SELECT id FROM t ORDER BY id;
SELECT variable_value > @before_count AS measured FROM performance_schema.global_status
 WHERE variable_name='rocksdb_ttl_session_read_mismatches';
COMMIT;
SELECT variable_value INTO @before_count FROM performance_schema.global_status
 WHERE variable_name='rocksdb_ttl_session_read_mismatches';
# A new transaction captures 200: both clocks now agree on expiry 150.
SELECT id FROM t ORDER BY id;
SELECT variable_value = @before_count AS unchanged FROM performance_schema.global_status
 WHERE variable_name='rocksdb_ttl_session_read_mismatches';
SET timestamp=100;
# A hypothetical live row must not prevent real TTL duplicate-key reuse.
INSERT INTO t VALUES(1,0);
SELECT id FROM t ORDER BY id;
INSERT INTO t VALUES(3,150);
# Shadow does not hold back compaction, even with the session time backdated.
SET GLOBAL rocksdb_force_flush_memtable_now=ON;
SET GLOBAL rocksdb_compact_cf='default';
SET GLOBAL rocksdb_enable_ttl_read_filtering=OFF;
SELECT id FROM t ORDER BY id;
SET GLOBAL rocksdb_enable_ttl_read_filtering=ON;
DROP TABLE t,ti;
SET timestamp=DEFAULT;
SET SESSION transaction_isolation=DEFAULT;

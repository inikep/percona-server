DROP TABLE IF EXISTS t1;
CREATE TABLE t1 (
id INT,
val1 INT,
val2 INT,
PRIMARY KEY (id)
) ENGINE=rocksdb;
INSERT INTO t1 VALUES(1,1,1),(2,1,2);
SELECT * FROM t1;
id	val1	val2
1	1	1
2	1	2
UPDATE t1 SET val1=2 WHERE id=2;
SELECT * FROM t1;
id	val1	val2
1	1	1
2	2	2
SELECT WRITE_COUNT, LOCK_COUNT, READ_ONLY
FROM information_schema.rocksdb_trx
WHERE THREAD_ID = CONNECTION_ID();
WRITE_COUNT	LOCK_COUNT	READ_ONLY
SET AUTOCOMMIT=0;
START TRANSACTION;
INSERT INTO t1 VALUES(20,1,1),(30,30,30);
SELECT * FROM t1;
id	val1	val2
1	1	1
2	2	2
20	1	1
30	30	30
UPDATE t1 SET val1=20, val2=20 WHERE id=20;
SELECT * FROM t1;
id	val1	val2
1	1	1
2	2	2
20	20	20
30	30	30
DELETE FROM t1 WHERE id=30;
SELECT WRITE_COUNT, LOCK_COUNT, READ_ONLY
FROM information_schema.rocksdb_trx
WHERE THREAD_ID = CONNECTION_ID();
WRITE_COUNT	LOCK_COUNT	READ_ONLY
4	4	0
ROLLBACK;
SELECT WRITE_COUNT, LOCK_COUNT, READ_ONLY
FROM information_schema.rocksdb_trx
WHERE THREAD_ID = CONNECTION_ID();
WRITE_COUNT	LOCK_COUNT	READ_ONLY
START TRANSACTION;
INSERT INTO t1 VALUES(40,40,40);
SELECT WRITE_COUNT, LOCK_COUNT, READ_ONLY
FROM information_schema.rocksdb_trx
WHERE THREAD_ID = CONNECTION_ID();
WRITE_COUNT	LOCK_COUNT	READ_ONLY
1	1	0
COMMIT;
SELECT WRITE_COUNT, LOCK_COUNT, READ_ONLY
FROM information_schema.rocksdb_trx
WHERE THREAD_ID = CONNECTION_ID();
WRITE_COUNT	LOCK_COUNT	READ_ONLY
SET AUTOCOMMIT=1;
DROP TABLE t1;
DROP TABLE IF EXISTS t2;
CREATE TABLE t2 (
id1 INT,
id2 INT,
value INT,
PRIMARY KEY (id1),
KEY (id2)
) ENGINE=rocksdb;
SET AUTOCOMMIT=0;
START TRANSACTION;
INSERT INTO t2 VALUES(1,2,0),(10,20,30);
UPDATE t2 SET value=3 WHERE id2=2;
DELETE FROM t2 WHERE id1=10;
SELECT WRITE_COUNT, LOCK_COUNT, READ_ONLY
FROM information_schema.rocksdb_trx
WHERE THREAD_ID = CONNECTION_ID();
WRITE_COUNT	LOCK_COUNT	READ_ONLY
7	4	0
ROLLBACK;
SET AUTOCOMMIT=1;
DROP TABLE t2;
DROP TABLE IF EXISTS t2;
CREATE TABLE t2 (
id1 INT,
id2 INT,
value INT,
PRIMARY KEY (id1),
UNIQUE KEY (id2)
) ENGINE=rocksdb;
SET AUTOCOMMIT=0;
START TRANSACTION;
INSERT INTO t2 VALUES(1,2,0),(10,20,30);
UPDATE t2 SET value=3 WHERE id2=2;
DELETE FROM t2 WHERE id1=10;
SELECT WRITE_COUNT, LOCK_COUNT, READ_ONLY
FROM information_schema.rocksdb_trx
WHERE THREAD_ID = CONNECTION_ID();
WRITE_COUNT	LOCK_COUNT	READ_ONLY
7	4	0
ROLLBACK;
SET AUTOCOMMIT=1;
DROP TABLE t2;

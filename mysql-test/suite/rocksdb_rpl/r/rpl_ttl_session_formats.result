SET timestamp=100;
CREATE TABLE t(id INT PRIMARY KEY,e BIGINT UNSIGNED NOT NULL,v INT,KEY(v)) ENGINE=ROCKSDB COMMENT='row_ttl_col=e;';
CREATE TABLE ti(id INT PRIMARY KEY) ENGINE=ROCKSDB COMMENT='ttl_duration=10;';

SET timestamp=100;
CREATE TABLE t (id INT PRIMARY KEY, expiry BIGINT, v INT, UNIQUE KEY(v))
ENGINE=ROCKSDB COMMENT='row_ttl_col=expiry';
INSERT INTO t VALUES (1,150,1),(2,50,2),(3,0,3),(4,150,4);
CREATE TABLE ti (id INT PRIMARY KEY) ENGINE=ROCKSDB COMMENT='ttl_duration=100';
INSERT INTO ti VALUES(1);

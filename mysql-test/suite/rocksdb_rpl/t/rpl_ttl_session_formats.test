--source include/have_rocksdb.inc
--source include/rpl/init_source_replica.inc
--connection master
--let $ttl_master_datadir=`SELECT CONCAT(@@datadir, @@rocksdb_datadir)`
SET timestamp=100;
CREATE TABLE t(id INT PRIMARY KEY,e BIGINT UNSIGNED NOT NULL,v INT,KEY(v)) ENGINE=ROCKSDB COMMENT='row_ttl_col=e;';
CREATE TABLE ti(id INT PRIMARY KEY) ENGINE=ROCKSDB COMMENT='ttl_duration=10;';
INSERT INTO t VALUES(1,110,1);
INSERT INTO ti VALUES(1);
--source include/rpl/sync_to_replica.inc
--connection slave
--let $ttl_slave_datadir=`SELECT CONCAT(@@datadir, @@rocksdb_datadir)`
--source include/rpl/stop_applier.inc
--connection master
SET timestamp=108;
UPDATE t SET e=120,v=2 WHERE id=1;
UPDATE ti SET id=2 WHERE id=1;
--connection slave
# The durable horizon must preserve both before images while apply is stopped.
SET GLOBAL rocksdb_force_flush_memtable_now=ON;
SET GLOBAL rocksdb_compact_cf='default';
SET timestamp=100;
SELECT * FROM t;
SELECT * FROM ti;
--source include/rpl/start_applier.inc
--connection master
--source include/rpl/sync_to_replica.inc
--connection slave
SET timestamp=115;
SELECT * FROM t FORCE INDEX(v);
SELECT * FROM ti;
SET GLOBAL rocksdb_ttl_safe_purge_timestamp=120;
SET GLOBAL rocksdb_force_flush_memtable_now=ON;
SET GLOBAL rocksdb_compact_cf='default';
SET timestamp=120;
SET GLOBAL rocksdb_enable_ttl_read_filtering=OFF;
SELECT * FROM t;
SELECT * FROM ti;
SET GLOBAL rocksdb_enable_ttl_read_filtering=ON;
--connection master
SET timestamp=120;
DROP TABLE t,ti;
--source include/rpl/sync_to_replica.inc
--source include/rpl/deinit.inc
--connection master
--let $restart_parameters=restart: --rocksdb-ttl-session-bootstrap-timestamp=0 --rocksdb-ttl-use-session-timestamp=OFF --rocksdb-ttl-session-allow-legacy-transition=ON
--source include/restart_mysqld.inc
--connection slave
--let $restart_parameters=restart: --rocksdb-ttl-session-bootstrap-timestamp=0 --rocksdb-ttl-use-session-timestamp=OFF --rocksdb-ttl-session-allow-legacy-transition=ON
--source include/restart_mysqld.inc
--connection master
--let $restart_parameters=restart: --rocksdb-datadir=.rocksdb --rocksdb-ttl-session-bootstrap-timestamp=0 --rocksdb-ttl-use-session-timestamp=OFF --rocksdb-ttl-session-allow-legacy-transition=OFF
--source include/restart_mysqld.inc
--force-rmdir $ttl_master_datadir
--connection slave
--let $restart_parameters=restart: --rocksdb-datadir=.rocksdb --rocksdb-ttl-session-bootstrap-timestamp=0 --rocksdb-ttl-use-session-timestamp=OFF --rocksdb-ttl-session-allow-legacy-transition=OFF
--source include/restart_mysqld.inc
--force-rmdir $ttl_slave_datadir

SELECT IFNULL(MAX(filter_id), 0) + 1, 'inv_both', CAST('{"filter":{"class":{"name":"table_access","event":{"name":"insert","log":{"field":{"name":"table_name.str","value":"x","regex":"y"}}}}}}' AS JSON)
FROM mysql.audit_log_filter;
INSERT INTO mysql.audit_log_filter (filter_id, name, filter)
SELECT IFNULL(MAX(filter_id), 0) + 1, 'inv_nested', CAST('{"filter":{"id":"main","class":{"name":"table_access","event":{"name":"insert","log":false,"filter":{"class":{"name":"general","event":{"name":"status","log":true,"filter":{"ref":"main"}}},"activate":{"field":{"name":"table_name.str","value":"a","regex":"b"}}}}}}}' AS JSON)
FROM mysql.audit_log_filter;
SELECT name FROM mysql.audit_log_filter WHERE JSON_CONTAINS_PATH(filter, 'one', '$**.regex') AND name LIKE 'inv_%' ORDER BY name;
name
inv_both
inv_nested
DELETE FROM mysql.audit_log_filter WHERE name LIKE 'inv_%';
#
# REDUCED mode skips a disabled class but still validates a disabled subclass.
#
SET GLOBAL audit_log_filter.event_mode = REDUCED;
INSERT INTO mysql.audit_log_filter (filter_id, name, filter)
SELECT IFNULL(MAX(filter_id), 0) + 1, 'rx_skip_class', CAST('{"filter":{"class":{"name":"query","event":{"name":"start","log":{"field":{"name":"query.str","regex":"^(orders"}}}}}}' AS JSON)
FROM mysql.audit_log_filter;
SELECT audit_log_filter_flush();
audit_log_filter_flush()
OK
DELETE FROM mysql.audit_log_filter WHERE name = 'rx_skip_class';

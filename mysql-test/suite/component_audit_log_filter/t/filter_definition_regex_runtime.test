--echo # KILL QUERY retains the terminal status and the recovery statement
SELECT audit_log_filter_set_filter('rx_kill', '{"filter":{"class":{"name":"general","event":{"name":"status","log":{"field":{"name":"general_query.str","regex":"rx_kill_(stmt|recovery)"}}}}}}');
SELECT audit_log_filter_set_user('rx_kill_user@localhost', 'rx_kill');
--let $regex_before = `SELECT VARIABLE_VALUE FROM performance_schema.global_status WHERE VARIABLE_NAME = 'Audit_log_filter_regex_match_errors'`
SELECT audit_log_rotate();
--connection default
START TRANSACTION;
SELECT * FROM test.rx_kill_data WHERE id = 1 FOR UPDATE;
connect(victim, localhost, rx_kill_user, rx, test);
--connection victim
--let $victim_id = `SELECT CONNECTION_ID()`
--send UPDATE test.rx_kill_data SET v = v + 1 WHERE id = 1 /*rx_kill_stmt*/
--connection default
--let $wait_condition = SELECT COUNT(*) > 0 FROM performance_schema.data_lock_waits w JOIN performance_schema.threads t ON w.REQUESTING_THREAD_ID = t.THREAD_ID WHERE t.PROCESSLIST_ID = $victim_id
--source include/wait_condition.inc
--eval KILL QUERY $victim_id
--connection victim
--error ER_QUERY_INTERRUPTED
--reap
SELECT 1 /*rx_kill_recovery*/;
--connection default
COMMIT;
--let rx_log = `SELECT audit_log_rotate()`
--remove_file $rx_spec_file
--write_file $rx_spec_file
sql|1|rx_kill_stmt
sql|1|rx_kill_recovery
EOF
--source filter_definition_regex_check_log.inc
--let $regex_delta = `SELECT VARIABLE_VALUE - $regex_before FROM performance_schema.global_status WHERE VARIABLE_NAME = 'Audit_log_filter_regex_match_errors'`
--let $v = `SELECT v FROM test.rx_kill_data WHERE id = 1`
if ($v != 0)
{
  --die killed query was committed
}
if ($regex_delta != 0)
{
  --die kill query incremented regex errors
}
disconnect victim;
--enable_result_log
--echo kill query delta $regex_delta
--echo kill query OK
--disable_result_log

--echo # Pre-reset query event
SET GLOBAL audit_log_filter.event_mode = FULL;
SELECT audit_log_filter_remove_user('rx_kill_user@localhost');
SELECT audit_log_filter_set_filter('rx_kill_query', '{"filter":{"class":{"name":"query","event":{"name":"status_end","log":{"field":{"name":"query.str","regex":"rx_kill_stmt"}}}}}}');
SELECT audit_log_filter_set_user('rx_kill_user@localhost', 'rx_kill_query');
--let $regex_before = `SELECT VARIABLE_VALUE FROM performance_schema.global_status WHERE VARIABLE_NAME = 'Audit_log_filter_regex_match_errors'`
SELECT audit_log_rotate();
START TRANSACTION;
SELECT * FROM test.rx_kill_data WHERE id = 1 FOR UPDATE;
connect(victim, localhost, rx_kill_user, rx, test);
--connection victim
--let $victim_id = `SELECT CONNECTION_ID()`
--send UPDATE test.rx_kill_data SET v = v + 1 WHERE id = 1 /*rx_kill_stmt*/
--connection default
--let $wait_condition = SELECT COUNT(*) > 0 FROM performance_schema.data_lock_waits w JOIN performance_schema.threads t ON w.REQUESTING_THREAD_ID = t.THREAD_ID WHERE t.PROCESSLIST_ID = $victim_id
--source include/wait_condition.inc
--eval KILL QUERY $victim_id
--connection victim
--error ER_QUERY_INTERRUPTED
--reap
--connection default
COMMIT;
--let rx_log = `SELECT audit_log_rotate()`
--remove_file $rx_spec_file
--write_file $rx_spec_file
sql|1|rx_kill_stmt
EOF
--source filter_definition_regex_check_log.inc
--let $regex_delta = `SELECT VARIABLE_VALUE - $regex_before FROM performance_schema.global_status WHERE VARIABLE_NAME = 'Audit_log_filter_regex_match_errors'`
if ($regex_delta != 0)
{
  --die kill query-event incremented regex errors
}
disconnect victim;
SET GLOBAL audit_log_filter.event_mode = REDUCED;
--enable_result_log
--echo kill query-event delta $regex_delta
--echo kill query-event OK
--disable_result_log

--echo # KILL CONNECTION idle and active, including same-account kill
SELECT audit_log_filter_remove_user('rx_kill_user@localhost');
SELECT audit_log_filter_set_filter('rx_kill_disc', '{"filter":{"class":{"name":"connection","event":{"name":"disconnect","log":{"field":{"name":"user.str","regex":"^rx_kill_user$"}}}}}}');
SELECT audit_log_filter_set_user('rx_kill_user@localhost', 'rx_kill_disc');
--let $regex_before = `SELECT VARIABLE_VALUE FROM performance_schema.global_status WHERE VARIABLE_NAME = 'Audit_log_filter_regex_match_errors'`
SELECT audit_log_rotate();
connect(victim, localhost, rx_kill_user, rx, test);
connect(normal, localhost, rx_kill_user, rx, test);
--connection victim
--let killed_id = `SELECT CONNECTION_ID()`
--connection normal
--let normal_id = `SELECT CONNECTION_ID()`
--connection default
--eval KILL CONNECTION $killed_id
--let $wait_condition = SELECT COUNT(*) = 0 FROM performance_schema.threads WHERE PROCESSLIST_ID = $killed_id
--source include/wait_condition.inc
disconnect normal;
--connection victim
--error 2013
SELECT 1;
--disconnect victim
--connection default
perl;
  open my $f, '>', $ENV{rx_spec_file} or die $!;

# Real ICU timeout: only one general/status event per transmitted statement.
SET @definition = '{"filter":{"class":{"name":"general","event":{"name":"status","log":{"field":{"name":"general_query.str","regex":"(a+)+$"}}}}}}';
--source regex_assign.inc
SET @before=(SELECT VARIABLE_VALUE FROM performance_schema.global_status WHERE VARIABLE_NAME='Audit_log_filter_regex_match_errors');
--source regex_sync.inc
SELECT audit_log_rotate();
perl;
  use Time::HiRes qw(clock_gettime CLOCK_MONOTONIC);
  open my $f,'>',"$ENV{MYSQLTEST_VARDIR}/tmp/regex-clock" or die $!;
  print $f clock_gettime(CLOCK_MONOTONIC);
EOF
connection rx;
SELECT 'aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa';
SELECT 'aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa';
SELECT 'aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa';
DO 0;
connection default;
--let rx_count = 3
--source regex_check_count.inc
--enable_result_log
SELECT VARIABLE_VALUE-@before AS timeout_errors FROM performance_schema.global_status WHERE VARIABLE_NAME='Audit_log_filter_regex_match_errors';
--disable_result_log
perl;
  use Time::HiRes qw(clock_gettime CLOCK_MONOTONIC);
  open my $clock,'<',"$ENV{MYSQLTEST_VARDIR}/tmp/regex-clock" or die $!;
  my $elapsed=clock_gettime(CLOCK_MONOTONIC)-<$clock>;
  open my $f,'<',"$ENV{MYSQLTEST_VARDIR}/log/mysqld.1.err" or die $!;
  my $log=do {local $/; <$f>};
  $log =~ s/.*CURRENT_TEST: component_audit_log_filter.filter_definition_regex_runtime//s;
  my $message="Audit log filter 'rx': regex '(a+)+\$' on field 'general_query.str' failed (timeout: U_REGEX_TIME_OUT). Further failures of this condition are reported at most once per 60 seconds.";
  my $count=(()=$log=~/\Q$message\E/g);
  die 'Timeout warning count/text' unless $count>=1 && $count<=3 && ($elapsed>=60 || $count==1);
EOF
--remove_file $MYSQLTEST_VARDIR/tmp/regex-clock
connection rx;
SELECT 1 AS aaaa;
DO 0;
connection default;
--let rx_count = 1
--source regex_check_count.inc
--enable_result_log
SELECT VARIABLE_VALUE-@before AS errors_after_recovery FROM performance_schema.global_status WHERE VARIABLE_NAME='Audit_log_filter_regex_match_errors';
--disable_result_log

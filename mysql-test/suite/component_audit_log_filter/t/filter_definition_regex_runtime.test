CREATE TABLE test.orders1(id INT);
SET @definition = '{"filter":{"class":{"name":"table_access","event":{"name":["insert", "update", "delete"],"log":{"and":[{"field":{"name":"table_database.str","value":"tpcc"}},{"field":{"name":"table_name.str","regex":"^(new_orders|orders|history)[0-9]+$"}}]}}}}}';
--source regex_assign.inc
connect(rx,localhost,rx,,test);
--let rx_connected = 1
connection default;
--source regex_sync.inc
SELECT audit_log_rotate();
connection rx;
INSERT INTO tpcc.new_orders1 VALUES (1);
UPDATE tpcc.new_orders1 SET id=2;
DELETE FROM tpcc.new_orders1;
INSERT INTO tpcc.orders1 VALUES (1);
UPDATE tpcc.orders1 SET id=2;
DELETE FROM tpcc.orders1;
INSERT INTO tpcc.history1 VALUES (1);
UPDATE tpcc.history1 SET id=2;
DELETE FROM tpcc.history1;
INSERT INTO tpcc.new_orders2 VALUES (1);
UPDATE tpcc.new_orders2 SET id=2;
DELETE FROM tpcc.new_orders2;
INSERT INTO tpcc.orders2 VALUES (1);
UPDATE tpcc.orders2 SET id=2;
DELETE FROM tpcc.orders2;
INSERT INTO tpcc.history2 VALUES (1);
UPDATE tpcc.history2 SET id=2;
DELETE FROM tpcc.history2;
connection default;
--source regex_sync.inc
--let rx_closed = `SELECT audit_log_rotate()`
perl;
  require "$ENV{MYSQL_TEST_DIR}/suite/component_audit_log_filter/t/regex_records.pl";
  my $records=regex_records();
  die 'Expected 18 records' unless @$records == 18;
  my %tuples;
  for my $r (@$records) { ++$tuples{"$r->{db}/$r->{table}/$r->{event}"}; }
  for my $t (qw(new_orders1 orders1 history1 new_orders2 orders2 history2)) {
    for my $op (qw(insert update delete)) {
      die "Missing/duplicate $t/$op" unless ($tuples{"tpcc/$t/$op"} || 0) == 1;
    }
  }
EOF

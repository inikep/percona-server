--echo # Real ICU timeout and recovery
SELECT audit_log_filter_remove_user('rx_dml@localhost');
SELECT audit_log_filter_set_filter('rx_icu', '{"filter":{"class":{"name":"general","event":{"name":"status","log":{"field":{"name":"general_query.str","regex":"(a+)+$"}}}}}}');
SELECT audit_log_filter_set_user('rx_dml@localhost', 'rx_icu');
--let $regex_before = `SELECT VARIABLE_VALUE FROM performance_schema.global_status WHERE VARIABLE_NAME = 'Audit_log_filter_regex_match_errors'`
perl;
  open my $f, '<', "$ENV{MYSQLTEST_VARDIR}/log/mysqld.1.err" or die $!;
  my $n = 0;
  while (<$f>) { $n++ if /U_REGEX_TIME_OUT/ }
  close $f;
  open my $o, '>', "$ENV{MYSQLTEST_VARDIR}/tmp/rx_warns.txt" or die $!;
  print $o $n;
  close $o;
EOF
SELECT audit_log_rotate();
connect(rx, localhost, rx_dml, rx, test);
--connection rx
SELECT 'aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa';
SELECT 'aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa';
SELECT 'aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa';
--let $regex_after = `SELECT VARIABLE_VALUE FROM performance_schema.global_status WHERE VARIABLE_NAME = 'Audit_log_filter_regex_match_errors'`
--connection default
--let rx_log = `SELECT audit_log_rotate()`
--remove_file $rx_spec_file
--write_file $rx_spec_file
sql|0|aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
EOF
--source filter_definition_regex_check_log.inc
--let $regex_delta = `SELECT $regex_after - $regex_before`
if ($regex_delta != 3)
{
  --echo icu timeout delta $regex_delta
  --die expected 3 regex match errors
}
SELECT audit_log_rotate();
--connection rx
SELECT 1 AS aaaa;
--let $regex_mid = `SELECT VARIABLE_VALUE FROM performance_schema.global_status WHERE VARIABLE_NAME = 'Audit_log_filter_regex_match_errors'`
--connection default
--let rx_log = `SELECT audit_log_rotate()`
--remove_file $rx_spec_file
--write_file $rx_spec_file
sql|1|SELECT 1 AS aaaa
EOF
--source filter_definition_regex_check_log.inc
--let $regex_delta = `SELECT $regex_mid - $regex_after`
if ($regex_delta != 0)
{
  --die recovery must not increment regex errors
}
disconnect rx;
perl;
  open my $f, '<', "$ENV{MYSQLTEST_VARDIR}/log/mysqld.1.err" or die $!;
  my $n = 0;
  while (<$f>) { $n++ if /U_REGEX_TIME_OUT/ }
  close $f;
  open my $o, '<', "$ENV{MYSQLTEST_VARDIR}/tmp/rx_warns.txt" or die $!;
  my $before = 0 + <$o>;
  close $o;
  my $delta = $n - $before;
  die "expected 1..3 timeout warnings, got $delta\n" if $delta < 1 || $delta > 3;
EOF
--enable_result_log
--echo icu timeout OK
--disable_result_log


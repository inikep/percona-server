perl;
  require "$ENV{MYSQL_TEST_DIR}/suite/component_audit_log_filter/t/regex_records.pl";
  my $r=regex_records();
  for my $op(qw(insert update delete)) {
    die "New shard $op missing or duplicated" unless 1==grep {$_->{table} eq 'history3' && $_->{event} eq $op} @$r;
  }
EOF

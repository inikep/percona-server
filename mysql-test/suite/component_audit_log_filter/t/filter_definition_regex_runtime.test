# PS-11118: regex field conditions at runtime.
--source include/have_component_audit_log.inc
--source ../inc/audit_tables_init.inc
--source ../inc/audit_comp_install.inc

call mtr.add_suppression("Component audit_log_filter reported: 'Wrong JSON filter '.*' format");
call mtr.add_suppression("Component audit_log_filter reported: 'audit_log_filter name: .*, filter: .* has wrong format");
call mtr.add_suppression("Component audit_log_filter reported: 'Audit log filter '.*': regex");
call mtr.add_suppression("Component audit_log_filter reported: 'Wrong argument: incorrect rule definition");
call mtr.add_suppression("Component audit_log_filter reported: 'Skipping disabled event");

--let rx_spec_file = $MYSQLTEST_VARDIR/tmp/rx_spec.txt
SET NAMES utf8mb4;
--disable_query_log
--disable_result_log

CREATE DATABASE IF NOT EXISTS tpcc;
CREATE USER rx_dml@localhost IDENTIFIED BY 'rx';
CREATE USER rx_exempt@localhost IDENTIFIED BY 'rx';
CREATE USER app_svc_1@localhost IDENTIFIED BY 'rx';
CREATE USER app_svc_2@localhost IDENTIFIED BY 'rx';
CREATE USER other_user@localhost IDENTIFIED BY 'rx';
CREATE USER rx_kill_user@localhost IDENTIFIED BY 'rx';
CREATE USER rx_cs@localhost;
GRANT ALL ON tpcc.* TO rx_dml@localhost;
GRANT ALL ON test.* TO rx_dml@localhost;
GRANT ALL ON tpcc.* TO rx_exempt@localhost;
GRANT ALL ON test.* TO rx_exempt@localhost;
GRANT SYSTEM_USER, AUDIT_ABORT_EXEMPT ON *.* TO rx_exempt@localhost;
GRANT ALL ON test.* TO rx_kill_user@localhost;
GRANT ALL ON test.* TO rx_cs@localhost;

CREATE TABLE tpcc.new_orders1 (id INT PRIMARY KEY);
CREATE TABLE tpcc.orders1 (id INT PRIMARY KEY);
CREATE TABLE tpcc.history1 (id INT PRIMARY KEY);
CREATE TABLE tpcc.new_orders2 (id INT PRIMARY KEY);
CREATE TABLE tpcc.orders2 (id INT PRIMARY KEY);
CREATE TABLE tpcc.history2 (id INT PRIMARY KEY);
CREATE TABLE tpcc.customer1 (id INT PRIMARY KEY);
CREATE TABLE tpcc.orders_archive (id INT PRIMARY KEY);
CREATE TABLE tpcc.orders (id INT PRIMARY KEY);
CREATE TABLE tpcc.history3 (id INT PRIMARY KEY);
CREATE TABLE tpcc.zamówienia1 (id INT PRIMARY KEY);
CREATE TABLE test.orders1 (id INT PRIMARY KEY);
CREATE TABLE test.secret_1 (id INT PRIMARY KEY);
CREATE TABLE test.secret_x (id INT PRIMARY KEY);
CREATE TABLE test.temp_1 (id INT PRIMARY KEY);
CREATE TABLE test.keep_1 (id INT PRIMARY KEY);
CREATE TABLE test.keep_reload (id INT PRIMARY KEY);
CREATE TABLE test.rx_kill_data (id INT PRIMARY KEY, v INT);
CREATE TABLE test.rx_timeout_data (id INT PRIMARY KEY);
CREATE TABLE test.charset_filter_data (id INT PRIMARY KEY);

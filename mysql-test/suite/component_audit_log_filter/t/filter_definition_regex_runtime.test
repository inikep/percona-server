--disable_result_log
--let rx_warning_text = Audit log filter 'rx': regex '(a+)+$'
--let rx_warning_min = 0
--let rx_warning_max = 0
--source regex_warning_check.inc
--remove_file $MYSQLTEST_VARDIR/tmp/regex-warning-mark
# Print conditions retain original text only on a match.
SET @definition = JSON_OBJECT('filter',JSON_OBJECT('class',JSON_OBJECT('name','general','event',JSON_OBJECT('name','status','log',CAST('true' AS JSON),'print',JSON_OBJECT('field',JSON_OBJECT('name','general_query.str','print',JSON_OBJECT('field',JSON_OBJECT('name','general_query.str','regex',"^SELECT 'keep")),'replace',JSON_OBJECT('function',JSON_OBJECT('name','query_digest'))))))));
--source regex_assign.inc
--source regex_sync.inc
SELECT audit_log_rotate();
connection rx;
SELECT 'keep_me';
SELECT 'mask_me';
connection default;
--source regex_sync.inc
--let rx_closed = `SELECT audit_log_rotate()`
perl;
  require "$ENV{MYSQL_TEST_DIR}/suite/component_audit_log_filter/t/regex_records.pl";
  my $r=regex_records();
  die 'Print record count' unless @$r == 2;
  die 'Original not kept' unless 1 == grep {$_->{query} eq "SELECT 'keep_me'"} @$r;
  die 'Digest not used' unless 1 == grep {$_->{query} eq 'SELECT ?'} @$r;
EOF
# Abort applies to matching identifiers; an exempt account still succeeds.
SET @definition='{"filter":{"class":{"name":"table_access","event":{"name":"insert","abort":{"field":{"name":"table_name.str","regex":"^secret_[0-9]+$"}}}}}}';
--source regex_assign.inc
connection rx;
--error ER_AUDIT_API_ABORT
INSERT INTO tpcc.secret_1 VALUES (1);
INSERT INTO tpcc.secret_x VALUES (1);
connection default;
--enable_result_log
SELECT COUNT(*) AS blocked_rows FROM tpcc.secret_1;
SELECT COUNT(*) AS allowed_rows FROM tpcc.secret_x;
--disable_result_log
GRANT SYSTEM_USER, AUDIT_ABORT_EXEMPT ON *.* TO rx@localhost;
disconnect rx;
connect(rx,localhost,rx,,test);
INSERT INTO tpcc.secret_1 VALUES (1);
connection default;
--enable_result_log
SELECT COUNT(*) AS exempt_rows FROM tpcc.secret_1;
--disable_result_log
REVOKE SYSTEM_USER, AUDIT_ABORT_EXEMPT ON *.* FROM rx@localhost;
--source regex_runtime_extra.inc
connection default;
disconnect rx;
DROP TABLE test.orders1;
DROP DATABASE tpcc;
DROP USER rx@localhost;
--enable_result_log
--enable_query_log
--echo Regex runtime and action checks passed
--source ../inc/audit_comp_uninstall.inc

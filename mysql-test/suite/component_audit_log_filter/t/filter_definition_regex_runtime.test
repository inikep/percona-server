--echo # Print condition
SELECT audit_log_filter_remove_user('rx_dml@localhost');
SET @print = JSON_OBJECT('field', JSON_OBJECT('name', 'general_query.str', 'regex', '^SELECT \'keep'));
SET @action = JSON_OBJECT('field', JSON_OBJECT('name', 'general_query.str', 'print', CAST(@print AS JSON), 'replace', JSON_OBJECT('function', JSON_OBJECT('name', 'query_digest'))));
SET @definition = JSON_OBJECT('filter', JSON_OBJECT('class', JSON_OBJECT('name', 'general', 'event', JSON_OBJECT('name', 'status', 'log', CAST('true' AS JSON), 'print', CAST(@action AS JSON)))));
SELECT audit_log_filter_set_filter('rx_print', @definition);
SELECT audit_log_filter_set_user('rx_dml@localhost', 'rx_print');

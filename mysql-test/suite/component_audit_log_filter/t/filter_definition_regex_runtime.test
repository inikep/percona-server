--echo # Query charset: ASCII marker matches both, UTF-8 literal matches one
SELECT audit_log_filter_remove_user('rx_dml@localhost');
SET @definition = JSON_OBJECT('filter', JSON_OBJECT('class', JSON_OBJECT('name', 'general', 'event', JSON_OBJECT('name', 'status', 'log', JSON_OBJECT('field', JSON_OBJECT('name', 'general_query.str', 'regex', 'rx_cs_marker'))))));
SELECT audit_log_filter_set_filter('rx_cs_marker', @definition);
SELECT audit_log_filter_set_user('rx_cs@localhost', 'rx_cs_marker');
perl;
  use strict;
  use warnings;
  use Encode qw(decode encode);
  my $q = decode('iso-8859-1', "SELECT 'caf\xE9' AS c /* rx_cs_marker */;\n");
  open my $latin1, '>:raw', "$ENV{MYSQLTEST_VARDIR}/tmp/rx_cs.latin1" or die $!;
  print $latin1 encode('iso-8859-1', $q);
  close $latin1;
  open my $utf8, '>:raw', "$ENV{MYSQLTEST_VARDIR}/tmp/rx_cs.utf8mb4" or die $!;
  print $utf8 encode('UTF-8', $q);
  close $utf8;
EOF
SELECT audit_log_rotate();
--exec $MYSQL --default-character-set=latin1 -u rx_cs test < $MYSQLTEST_VARDIR/tmp/rx_cs.latin1
--exec $MYSQL --default-character-set=utf8mb4 -u rx_cs test < $MYSQLTEST_VARDIR/tmp/rx_cs.utf8mb4

INSERT INTO tpcc.customer1 VALUES (1);
INSERT INTO tpcc.orders_archive VALUES (1);
INSERT INTO tpcc.orders VALUES (1);
INSERT INTO test.orders1 VALUES (1);
INSERT INTO test.rx_kill_data VALUES (1, 0);
INSERT INTO test.rx_timeout_data VALUES (1);
INSERT INTO test.charset_filter_data VALUES (1);


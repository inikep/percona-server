--echo #
--echo # PS-11934: a failed reopen of the log file on rotation was ignored, and
--echo # the next write used the closed writer: with encryption it crashed in
--echo # EVP_EncryptUpdate(), with compression it wrote to a finished stream
--echo #

--source include/have_component_audit_log.inc
--source include/have_component_keyring_file.inc
--source include/have_debug.inc
--source suite/component_keyring_file/inc/setup_component.inc
--source ../inc/audit_tables_init.inc
--source ../inc/audit_comp_install.inc

call mtr.add_suppression("Component audit_log_filter reported: 'Failed to fetch options for id");
call mtr.add_suppression("Component audit_log_filter reported: 'Failed to open audit log file after rotation");
call mtr.add_suppression("Component audit_log_filter reported: 'Log rotation failed");
call mtr.add_suppression("Component audit_log_filter reported: 'Failed to rotate audit filter log");

SELECT audit_log_filter_set_filter('log_all', '{"filter": {"log": true}}');
SELECT audit_log_filter_set_user('%', 'log_all');
--source clean_all_audit_logs.inc

--let $events_lost = SELECT VARIABLE_VALUE FROM performance_schema.global_status WHERE VARIABLE_NAME = 'Audit_log_filter_events_lost'
--let $events_written = SELECT VARIABLE_VALUE FROM performance_schema.global_status WHERE VARIABLE_NAME = 'Audit_log_filter_events_written'
--let $current_size = SELECT VARIABLE_VALUE FROM performance_schema.global_status WHERE VARIABLE_NAME = 'Audit_log_filter_current_size'

--echo #
--echo # 1. The new log file cannot be created
SET GLOBAL DEBUG = '+d,audit_log_filter_file_open_failure';
SELECT audit_log_rotate();
--echo # A rotation while the file still cannot be created does not rotate
SELECT audit_log_rotate();
SET GLOBAL DEBUG = '-d,audit_log_filter_file_open_failure';
--let $reopen_failure_step = 1
--source log_rotate_reopen_failure_step.inc

--echo #
--echo # 2. The log writer cannot be opened, the compressing and encrypting
--echo # writers above it release their state
SET GLOBAL DEBUG = '+d,audit_log_filter_file_writer_open_failure';
SELECT audit_log_rotate();
SET GLOBAL DEBUG = '-d,audit_log_filter_file_writer_open_failure';
--let $reopen_failure_step = 2
--source log_rotate_reopen_failure_step.inc

--echo #
--echo # 3. The encryption options cannot be fetched (without encryption the
--echo # log writer cannot be opened)
--let $reopen_failure = audit_log_filter_file_writer_open_failure
if (`SELECT @@global.audit_log_filter.encryption = 'AES'`) {
  --let $reopen_failure = audit_log_filter_encryption_options_fetch_failure
}
--disable_query_log
--eval SET GLOBAL DEBUG = '+d,$reopen_failure'
--enable_query_log
SELECT audit_log_rotate();
--disable_query_log
--eval SET GLOBAL DEBUG = '-d,$reopen_failure'
--enable_query_log
--let $reopen_failure_step = 3
--source log_rotate_reopen_failure_step.inc

--echo #
--echo # 4. The log file cannot be renamed and then the log writer cannot be
--echo # opened: the file keeps its footer and the next rotation renames it
SET GLOBAL DEBUG = '+d,audit_log_filter_rotate_rename_failure,audit_log_filter_file_writer_open_failure';
SELECT audit_log_rotate();
SET GLOBAL DEBUG = '-d,audit_log_filter_rotate_rename_failure,audit_log_filter_file_writer_open_failure';
--let $reopen_failure_step = 4
--source log_rotate_reopen_failure_step.inc

--echo #
--echo # 5. The log file cannot be renamed and then not opened
SET GLOBAL DEBUG = '+d,audit_log_filter_rotate_rename_failure,audit_log_filter_file_open_failure';
SELECT audit_log_rotate();
SET GLOBAL DEBUG = '-d,audit_log_filter_rotate_rename_failure,audit_log_filter_file_open_failure';
--let $reopen_failure_step = 5
--source log_rotate_reopen_failure_step.inc

--echo #
--echo # The logs can be read
--let $read_ok = `SELECT JSON_LENGTH(audit_log_read('{"start": {"timestamp": "2000-01-01 00:00:00"}, "max_array_length": 1000}')) > 0`
--echo log read: $read_ok
SELECT audit_log_read('null');

--echo #
--echo # Cleanup
--source ../inc/audit_comp_uninstall.inc
--let $datadir = `SELECT @@global.datadir`
--remove_files_wildcard $datadir audit_filter.*
--source ../inc/audit_tables_cleanup.inc
--source suite/component_keyring_file/inc/teardown_component.inc

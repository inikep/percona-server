--source include/have_debug.inc
--source regex_setup.inc
CALL mtr.add_suppression("bad 'regex' field condition");
CALL mtr.add_suppression("Wrong argument: incorrect rule definition");
CALL mtr.add_suppression("regex .* failed ");
CALL mtr.add_suppression("std::bad_alloc");
CALL mtr.add_suppression("Invalid audit query charset or buffer");
CALL mtr.add_suppression("Audit query output was not prepared");
SET SESSION debug='+d,audit_log_filter_regex_compile_bad_alloc';
--enable_result_log
SELECT audit_log_filter_set_filter('rx_oom','{"filter":{"class":{"name":"general","event":{"name":"status","log":{"field":{"name":"general_query.str","regex":"rx_error"}}}}}}') AS result;
SELECT COUNT(*) AS persisted FROM mysql.audit_log_filter WHERE name='rx_oom';
--disable_result_log
SET SESSION debug='-d,audit_log_filter_regex_compile_bad_alloc';
--enable_result_log
SELECT audit_log_filter_set_filter('rx_oom','{"filter":{"class":{"name":"general","event":{"name":"status","log":{"field":{"name":"general_query.str","regex":"rx_error"}}}}}}') AS result;
SELECT COUNT(*) AS persisted FROM mysql.audit_log_filter WHERE name='rx_oom';
--disable_result_log
SELECT audit_log_filter_remove_filter('rx_oom');
GRANT SESSION_VARIABLES_ADMIN ON *.* TO rx@localhost;
CREATE TABLE rx_errors(id INT);
connect(rx,localhost,rx,,test);
--let rx_connected = 1
connection default;
SET @guard=JSON_OBJECT('field',JSON_OBJECT('name','general_query.str','value','SELECT 11118 AS rx_error'));
SET @regex=JSON_OBJECT('field',JSON_OBJECT('name','general_query.str','regex','rx_error'));
--echo positive
SET @condition=JSON_OBJECT('and',JSON_ARRAY(CAST(@guard AS JSON),CAST(@regex AS JSON)));
SET @definition=JSON_OBJECT('filter',JSON_OBJECT('class',JSON_OBJECT('name','general','event',JSON_OBJECT('name','status','log',CAST(@condition AS JSON)))));
--source regex_assign.inc
--source regex_error_baseline.inc
connection rx;
SET SESSION debug='+d,audit_log_filter_regex_runtime_error';
SELECT 11118 AS rx_error;
SET SESSION debug='-d,audit_log_filter_regex_runtime_error';
connection default;
--let rx_count = 1
--source regex_check_count.inc
--source regex_error_delta.inc
--echo negative
SET @condition=JSON_OBJECT('and',JSON_ARRAY(CAST(@guard AS JSON),JSON_OBJECT('not',CAST(@regex AS JSON))));
SET @definition=JSON_OBJECT('filter',JSON_OBJECT('class',JSON_OBJECT('name','general','event',JSON_OBJECT('name','status','log',CAST(@condition AS JSON)))));
--source regex_assign.inc
--source regex_error_baseline.inc
connection rx;
SET SESSION debug='+d,audit_log_filter_regex_runtime_error';
SELECT 11118 AS rx_error;
SET SESSION debug='-d,audit_log_filter_regex_runtime_error';
connection default;
--let rx_count = 1
--source regex_check_count.inc
--source regex_error_delta.inc
--echo and_short
SET @condition=JSON_OBJECT('and',JSON_ARRAY(CAST(@guard AS JSON),JSON_OBJECT('and',JSON_ARRAY(JSON_OBJECT('field',JSON_OBJECT('name','general_command.str','value','NoSuchCommand')),CAST(@regex AS JSON)))));
SET @definition=JSON_OBJECT('filter',JSON_OBJECT('class',JSON_OBJECT('name','general','event',JSON_OBJECT('name','status','log',CAST(@condition AS JSON)))));
--source regex_assign.inc
--source regex_error_baseline.inc
connection rx;
SET SESSION debug='+d,audit_log_filter_regex_runtime_error';
SELECT 11118 AS rx_error;
SET SESSION debug='-d,audit_log_filter_regex_runtime_error';
connection default;
--let rx_count = 0
--source regex_check_count.inc
--source regex_error_delta.inc
--echo or_short
SET @condition=JSON_OBJECT('and',JSON_ARRAY(CAST(@guard AS JSON),JSON_OBJECT('or',JSON_ARRAY(JSON_OBJECT('field',JSON_OBJECT('name','general_command.str','value','Query')),CAST(@regex AS JSON)))));
SET @definition=JSON_OBJECT('filter',JSON_OBJECT('class',JSON_OBJECT('name','general','event',JSON_OBJECT('name','status','log',CAST(@condition AS JSON)))));
--source regex_assign.inc
--source regex_error_baseline.inc
connection rx;
SET SESSION debug='+d,audit_log_filter_regex_runtime_error';
SELECT 11118 AS rx_error;
SET SESSION debug='-d,audit_log_filter_regex_runtime_error';
connection default;
--let rx_count = 1
--source regex_check_count.inc
--source regex_error_delta.inc
# Positive and negated abort failures both block insertion.
--let rx_negate = 0
while ($rx_negate < 2) {
--echo abort_error negate=$rx_negate
SET @definition='{"filter":{"class":{"name":"table_access","event":{"name":"insert","abort":{"field":{"name":"table_name.str","regex":"rx_errors"}}}}}}';
if ($rx_negate) {
  SET @definition=JSON_SET(@definition, '$.filter.class.event.abort', JSON_OBJECT('not', JSON_EXTRACT(@definition, '$.filter.class.event.abort')));
}
--source regex_assign.inc
--source regex_error_baseline.inc
connection rx;
SET SESSION debug='+d,audit_log_filter_regex_runtime_error';
--error ER_AUDIT_API_ABORT
INSERT INTO rx_errors VALUES(1);
SET SESSION debug='-d,audit_log_filter_regex_runtime_error';
connection default;
--source regex_error_delta.inc
--enable_result_log
SELECT COUNT(*) AS allowed_after_regex_error FROM rx_errors;
--disable_result_log
--inc $rx_negate
}
# Failed print selects the digest, including under negation.
--let rx_negate = 0
while ($rx_negate < 2) {
--echo print_error negate=$rx_negate
SET @definition=JSON_OBJECT('filter',JSON_OBJECT('class',JSON_OBJECT('name','general','event',JSON_OBJECT('name','status','log',CAST(@guard AS JSON),'print',JSON_OBJECT('field',JSON_OBJECT('name','general_query.str','print',JSON_OBJECT('and',JSON_ARRAY(CAST(@guard AS JSON),CAST(@regex AS JSON))),'replace',JSON_OBJECT('function',JSON_OBJECT('name','query_digest'))))))));
if ($rx_negate) {
  SET @definition=JSON_SET(@definition, '$.filter.class.event.print.field.print', JSON_OBJECT('not', JSON_EXTRACT(@definition, '$.filter.class.event.print.field.print')));
}
--source regex_assign.inc
--source regex_error_baseline.inc
connection rx;
SET SESSION debug='+d,audit_log_filter_regex_runtime_error';
SELECT 11118 AS rx_error;
SET SESSION debug='-d,audit_log_filter_regex_runtime_error';
connection default;
--source regex_error_delta.inc
--source regex_sync.inc
--let rx_closed = `SELECT audit_log_rotate()`
perl;
  require "$ENV{MYSQL_TEST_DIR}/suite/component_audit_log_filter/t/regex_records.pl";
  my $r=regex_records();
  die 'Print failure did not redact' unless @$r==1 && $r->[0]->{query} eq 'SELECT ? AS `rx_error`';
EOF
--inc $rx_negate
}
# Failed activation cannot select the subsequent sentinel, even under not.
--let rx_negate = 0
while ($rx_negate < 2) {
--echo activate_error negate=$rx_negate
SET @definition='{"filter":{"class":{"name":"table_access","event":{"name":"insert","log":false,"filter":{"activate":{"field":{"name":"table_name.str","regex":"rx_errors"}},"class":{"name":"general","event":{"name":"status","log":{"field":{"name":"general_query.str","value":"SELECT 11118 AS rx_error"}}}}}}}}}';
if ($rx_negate) {
  SET @definition=JSON_SET(@definition, '$.filter.class.event.filter.activate', JSON_OBJECT('not', JSON_EXTRACT(@definition, '$.filter.class.event.filter.activate')));
}
--source regex_assign.inc
--source regex_error_baseline.inc
connection rx;
SET SESSION debug='+d,audit_log_filter_regex_runtime_error';
INSERT INTO rx_errors VALUES(2);
SET SESSION debug='-d,audit_log_filter_regex_runtime_error';
SELECT 11118 AS rx_error;
connection default;
--let rx_count = 0
--source regex_check_count.inc
--source regex_error_delta.inc
--inc $rx_negate
}
# Two separate conditions warn independently, repeated failures are suppressed.
SET @definition='{"filter":{"class":{"name":"general","event":{"name":"status","log":{"or":[{"and":[{"field":{"name":"general_query.str","value":"SELECT 11118 AS rx_error"}},{"field":{"name":"general_query.str","regex":"^warn_one"}}]},{"and":[{"field":{"name":"general_query.str","value":"SELECT 11119 AS rx_error"}},{"field":{"name":"general_query.str","regex":"^warn_two"}}]}]}}}}}';
--source regex_assign.inc
--source regex_error_baseline.inc
--source regex_warning_mark.inc
connection rx;
SET SESSION debug='+d,audit_log_filter_regex_runtime_error';
SELECT 11118 AS rx_error;
SELECT 11119 AS rx_error;
SELECT 11118 AS rx_error;
SELECT 11119 AS rx_error;
SET SESSION debug='-d,audit_log_filter_regex_runtime_error';
connection default;
--source regex_error_delta.inc
--let rx_warning_text = Audit log filter 'rx': regex '^warn_one' on field 'general_query.str' failed (allocation: U_MEMORY_ALLOCATION_ERROR); condition evaluation failed; log and abort actions fail closed. Further failures of this condition are reported at most once per 60 seconds.
--let rx_warning_min = 1
--let rx_warning_max = 2
--source regex_warning_check.inc
--let rx_warning_text = Audit log filter 'rx': regex '^warn_two' on field 'general_query.str' failed (allocation: U_MEMORY_ALLOCATION_ERROR); condition evaluation failed; log and abort actions fail closed. Further failures of this condition are reported at most once per 60 seconds.
--let rx_warning_min = 1
--let rx_warning_max = 2
--source regex_warning_check.inc
--remove_file $MYSQLTEST_VARDIR/tmp/regex-warning-mark
# Reached output failures are independent of regex failures.
SET @condition=JSON_OBJECT('and',JSON_ARRAY(CAST(@guard AS JSON),CAST(@regex AS JSON)));
SET @definition=JSON_OBJECT('filter',JSON_OBJECT('class',JSON_OBJECT('name','general','event',JSON_OBJECT('name','status','log',CAST(@condition AS JSON)))));
--source regex_assign.inc
--echo unknown_query_charset
--source regex_error_baseline.inc
connection rx;
SET SESSION debug='+d,audit_log_filter_unknown_query_charset';
SELECT 11118 AS rx_error;
SET SESSION debug='-d,audit_log_filter_unknown_query_charset';
DO 0;
connection default;
--source regex_error_delta.inc
--let rx_count = 0
--source regex_check_count.inc
--echo query_output_bad_alloc
--source regex_error_baseline.inc
connection rx;
SET SESSION debug='+d,audit_log_filter_query_output_bad_alloc';
SELECT 11118 AS rx_error;
SET SESSION debug='-d,audit_log_filter_query_output_bad_alloc';
DO 0;
connection default;
--source regex_error_delta.inc
--let rx_count = 0
--source regex_check_count.inc
--echo query_output_not_ready
--source regex_error_baseline.inc
connection rx;
SET SESSION debug='+d,audit_log_filter_query_output_not_ready';
SELECT 11118 AS rx_error;
SET SESSION debug='-d,audit_log_filter_query_output_not_ready';
DO 0;
connection default;
--source regex_error_delta.inc
--let rx_count = 0
--source regex_check_count.inc
--echo escape_bad_alloc
--source regex_error_baseline.inc
connection rx;
SET SESSION debug='+d,audit_log_filter_escape_bad_alloc';
SELECT 11118 AS rx_error;
SET SESSION debug='-d,audit_log_filter_escape_bad_alloc';
DO 0;
connection default;
--source regex_error_delta.inc
--let rx_count = 0
--source regex_check_count.inc
--echo write_payload_bad_alloc
--source regex_error_baseline.inc
connection rx;
# Seed the file: payload allocation is only reached after the first record.
SELECT 11118 AS rx_error;
DO 0;
connection default;
if ($rx_format == JSON) {
  SET @bookmark=audit_log_read_bookmark();
}
SET @written=(SELECT VARIABLE_VALUE FROM performance_schema.global_status WHERE VARIABLE_NAME='Audit_log_filter_events_written');
connection rx;
SET SESSION debug='+d,audit_log_filter_write_payload_bad_alloc';
SELECT 11118 AS rx_error;
SET SESSION debug='-d,audit_log_filter_write_payload_bad_alloc';
DO 0;
connection default;
--source regex_error_delta.inc
--enable_result_log
if ($rx_format == JSON) {
  --let bookmark_unchanged = `SELECT audit_log_read_bookmark()=@bookmark`
  if (!$bookmark_unchanged) {
    --die Failed payload advanced the bookmark
  }
}
SELECT VARIABLE_VALUE-@written AS failed_payload_written FROM performance_schema.global_status WHERE VARIABLE_NAME='Audit_log_filter_events_written';
--disable_result_log
# A successful write in the same file must publish a new bookmark again.
connection rx;
SELECT 11118 AS rx_error;
connection default;
--source regex_sync.inc
if ($rx_format == JSON) {
  --let bookmark_advanced = `SELECT audit_log_read_bookmark()<>@bookmark`
  if (!$bookmark_advanced) {
    --die Payload recovery did not advance the bookmark
  }
}
--let recovery_written = `SELECT VARIABLE_VALUE-@written FROM performance_schema.global_status WHERE VARIABLE_NAME='Audit_log_filter_events_written'`
if ($recovery_written != 1) {
  --die Payload recovery did not write exactly one event
}
--let rx_count = 2
--source regex_check_count.inc
# Compare capture failures against the same workload without a regex condition.
# FULL mode emits several notifications per command; their exact number is not
# part of the regex contract. Both runs must lose the same nonzero number.
--echo query_capture_bad_alloc
--let capture_hook = audit_log_filter_query_capture_bad_alloc
--source regex_capture_failure.inc
--echo query_charset_bad_alloc
--let capture_hook = audit_log_filter_query_charset_bad_alloc
--source regex_capture_failure.inc
# A negated failed regex can reach an independently failing output stage.
SET @condition=JSON_OBJECT('and',JSON_ARRAY(CAST(@guard AS JSON),JSON_OBJECT('not',CAST(@regex AS JSON))));
SET @definition=JSON_OBJECT('filter',JSON_OBJECT('class',JSON_OBJECT('name','general','event',JSON_OBJECT('name','status','log',CAST(@condition AS JSON)))));
--source regex_assign.inc
--source regex_error_baseline.inc
connection rx;
SET SESSION debug='+d,audit_log_filter_regex_runtime_error,audit_log_filter_query_output_bad_alloc';
SELECT 11118 AS rx_error;
SET SESSION debug='-d,audit_log_filter_regex_runtime_error,audit_log_filter_query_output_bad_alloc';
connection default;
--source regex_error_delta.inc
# Clearing both hooks restores the real positive match and writing.
SET @definition=JSON_OBJECT('filter',JSON_OBJECT('class',JSON_OBJECT('name','general','event',JSON_OBJECT('name','status','log',JSON_OBJECT('and',JSON_ARRAY(CAST(@guard AS JSON),CAST(@regex AS JSON)))))));
--source regex_assign.inc
--source regex_error_baseline.inc
connection rx;
SELECT 11118 AS rx_error;
connection default;
--source regex_error_delta.inc
--let rx_count = 1
--source regex_check_count.inc
disconnect rx;
DROP TABLE rx_errors;
DROP USER rx@localhost;
--enable_result_log
--enable_query_log
--source ../inc/audit_comp_uninstall.inc
--source ../inc/audit_tables_cleanup.inc

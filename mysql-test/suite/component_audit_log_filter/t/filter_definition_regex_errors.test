INSERT INTO rx_errors VALUES(2);
SET SESSION debug='-d,audit_log_filter_regex_runtime_error';
SELECT 11118 AS rx_error;
connection default;
--let rx_count = 0
--source regex_check_count.inc
--source regex_error_delta.inc
# Two separate conditions warn independently, repeated failures are suppressed.
SET @definition=JSON_OBJECT('filter',JSON_OBJECT('class',JSON_OBJECT('name','general','event',JSON_OBJECT('name','status','log',JSON_OBJECT('and',JSON_ARRAY(CAST(@guard AS JSON),JSON_OBJECT('or',JSON_ARRAY(JSON_OBJECT('field',JSON_OBJECT('name','general_query.str','regex','^warn_one')),JSON_OBJECT('field',JSON_OBJECT('name','general_query.str','regex','^warn_two'))))))))));
--source regex_assign.inc
--source regex_error_baseline.inc
connection rx;
SET SESSION debug='+d,audit_log_filter_regex_runtime_error';
SELECT 11118 AS rx_error;
SELECT 11118 AS rx_error;
SET SESSION debug='-d,audit_log_filter_regex_runtime_error';
connection default;
--source regex_error_delta.inc
perl;
  open my $f,'<',"$ENV{MYSQLTEST_VARDIR}/log/mysqld.1.err" or die $!;
  my $log=do { local $/; <$f> };
  $log =~ s/.*CURRENT_TEST: component_audit_log_filter.filter_definition_regex_errors//s;
  for my $pattern(qw(^warn_one ^warn_two)) {
    my $message="Audit log filter 'rx': regex '$pattern' on field 'general_query.str' failed (allocation: U_MEMORY_ALLOCATION_ERROR); condition treated as not matching. Further failures of this condition are reported at most once per 60 seconds.";
    die "Wrong warning count/text: $pattern" unless 1==(()=$log=~/\Q$message\E/g);
  }
EOF
# Reached output failures are independent of regex failures.
SET @condition=JSON_OBJECT('and',JSON_ARRAY(CAST(@guard AS JSON),CAST(@regex AS JSON)));
SET @definition=JSON_OBJECT('filter',JSON_OBJECT('class',JSON_OBJECT('name','general','event',JSON_OBJECT('name','status','log',CAST(@condition AS JSON)))));

SELECT COUNT(*) AS persisted FROM mysql.audit_log_filter WHERE name='rx30';
SELECT audit_log_filter_set_filter('rx31', '{"filter":{"class":{"name":"table_access","event":{"name":"insert","abort":{"field":{"name":"table_name.str","regex":""}}}}}}') AS result;
SELECT COUNT(*) AS persisted FROM mysql.audit_log_filter WHERE name='rx31';
SELECT audit_log_filter_set_filter('rx32', '{"filter":{"class":{"name":"table_access","event":{"name":"insert","log":{"and":[{"field":{"name":"table_name.str","regex":""}}]}}}}}') AS result;
SELECT COUNT(*) AS persisted FROM mysql.audit_log_filter WHERE name='rx32';
SELECT audit_log_filter_set_filter('rx33', '{"filter":{"class":{"name":"table_access","event":{"name":"insert","log":{"or":[{"field":{"name":"table_name.str","regex":""}}]}}}}}') AS result;
SELECT COUNT(*) AS persisted FROM mysql.audit_log_filter WHERE name='rx33';
SELECT audit_log_filter_set_filter('rx34', '{"filter":{"class":{"name":"table_access","event":{"name":"insert","log":{"not":{"field":{"name":"table_name.str","regex":""}}}}}}}') AS result;
SELECT COUNT(*) AS persisted FROM mysql.audit_log_filter WHERE name='rx34';
SELECT audit_log_filter_set_filter('rx35', '{"filter":{"class":{"name":"general","event":{"name":"status","print":{"field":{"name":"general_query.str","print":{"field":{"name":"general_query.str","regex":""}},"replace":{"function":{"name":"query_digest"}}}}}}}}') AS result;
SELECT COUNT(*) AS persisted FROM mysql.audit_log_filter WHERE name='rx35';
SELECT audit_log_filter_set_filter('rx36', '{"filter":{"class":{"name":"table_access","event":{"name":"insert","filter":{"activate":{"field":{"name":"table_name.str","regex":""}},"class":{"name":"general","event":{"name":"status","log":true}}}}}}}') AS result;
SELECT COUNT(*) AS persisted FROM mysql.audit_log_filter WHERE name='rx36';
--error ER_CANT_INITIALIZE_UDF
SELECT audit_log_filter_set_filter('rx_large', REPEAT('x', 16385));
SELECT COUNT(*) AS persisted FROM mysql.audit_log_filter WHERE name='rx_large';
# Conservative upgrade inventory checks actual keys at every nesting level.
INSERT INTO mysql.audit_log_filter(filter_id,name,filter) VALUES
 (1001,'inventory_literal', '{"field":{"name":"x","value":"regex"}}'),
 (1002,'inventory_both', '{"field":{"name":"x","value":"x","regex":"x"}}'),
 (1003,'inventory_nested', '{"filter":{"class":[{"event":{"filter":{"activate":{"field":{"value":"x","regex":"x"}}}}}]}}');
SELECT name FROM mysql.audit_log_filter WHERE name LIKE 'inventory_%' AND JSON_CONTAINS_PATH(filter,'one','$**.regex') ORDER BY name;
SET SESSION sql_mode=DEFAULT;
--source ../inc/audit_comp_uninstall.inc
--source ../inc/audit_tables_cleanup.inc

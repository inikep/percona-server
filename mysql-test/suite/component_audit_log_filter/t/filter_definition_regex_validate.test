--source include/have_component_audit_log.inc
--source ../inc/audit_tables_init.inc
--source ../inc/audit_comp_install.inc
--disable_query_log
CALL mtr.add_suppression("Wrong JSON filter");
CALL mtr.add_suppression("Wrong argument: incorrect rule definition");
SET NAMES utf8mb4;
SET SESSION sql_mode='NO_BACKSLASH_ESCAPES';
--enable_query_log
SELECT audit_log_filter_set_filter('rx00', '{"filter":{"class":{"name":"table_access","event":{"name":"insert","log":{"field":{"name":"table_name.str","regex":""}}}}}}') AS result;
SELECT COUNT(*) AS persisted FROM mysql.audit_log_filter WHERE name='rx00';
SELECT audit_log_filter_set_filter('rx01', '{"filter":{"class":{"name":"table_access","event":{"name":"insert","log":{"field":{"name":"table_name.str","regex":"orders[0-9]+"}}}}}}') AS result;
SELECT COUNT(*) AS persisted FROM mysql.audit_log_filter WHERE name='rx01';
SELECT audit_log_filter_set_filter('rx02', '{"filter":{"class":{"name":"table_access","event":{"name":"insert","log":{"field":{"name":"table_name.str","value":"orders1","regex":"x"}}}}}}') AS result;
SELECT COUNT(*) AS persisted FROM mysql.audit_log_filter WHERE name='rx02';

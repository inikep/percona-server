--echo #
--echo # PS-11934: read sessions kept raw pointers to the reader's file list,
--echo # and a read sequence started by another session freed the entries of
--echo # the log files removed from disk, so the next audit_log_read() of the
--echo # first session used freed memory
--echo #

--source include/have_component_audit_log.inc
--source include/have_debug.inc
--source ../inc/audit_tables_init.inc
--source ../inc/audit_comp_install.inc

call mtr.add_suppression("Component audit_log_filter reported: 'Failed to open file for reading");

--let $audit_filter_log_path = `SELECT @@global.datadir`

CREATE TABLE t1 (c1 INT);

SELECT audit_log_filter_set_filter('log_inserts', '{"filter": {"class": {"name": "table_access", "event": {"name": "insert", "log": true}}}}');
SELECT audit_log_filter_set_user('%', 'log_inserts');

--source clean_all_audit_logs.inc

# Records of different logs get different timestamps
SET GLOBAL DEBUG = '+d,audit_log_filter_debug_timestamp';

--echo # Two rotated logs with three events each
INSERT INTO t1 VALUES (1);
INSERT INTO t1 VALUES (2);
INSERT INTO t1 VALUES (3);
--let $first_log = `SELECT audit_log_rotate()`
INSERT INTO t1 VALUES (4);
INSERT INTO t1 VALUES (5);
INSERT INTO t1 VALUES (6);
--let $second_log = `SELECT audit_log_rotate()`

--echo # Session A reads the first event, the second log is still to be read
connect (conn_a, localhost, root,, test);
--disable_result_log
SELECT audit_log_read('{"start": {"timestamp": "2000-01-01 00:00:00"}, "max_array_length": 1}');
--enable_result_log

--echo # The second log is removed, and session B starts a read sequence, which
--echo # drops the removed log from the reader's file list
connection default;
--remove_file $audit_filter_log_path/$second_log
--replace_column 1 <file_name>
SELECT audit_log_rotate();
connect (conn_b, localhost, root,, test);
--disable_result_log
SELECT audit_log_read('{"start": {"timestamp": "2000-01-01 00:00:00"}}');
--enable_result_log
SELECT audit_log_read('null');
disconnect conn_b;

--echo # Session A reads the rest of the first log, then fails to open the
--echo # removed one instead of using the freed entry
connection conn_a;
--error ER_UDF_ERROR
SELECT audit_log_read('{"max_array_length": 10}');
disconnect conn_a;

--echo #
--echo # Cleanup
connection default;
SET GLOBAL DEBUG = '-d,audit_log_filter_debug_timestamp';
DROP TABLE t1;

--source ../inc/audit_comp_uninstall.inc
--source ../inc/audit_tables_cleanup.inc
